{
  "manifest_version": 3,
  "name": "Public Wi-Fi Phishing Alert",
  "short_name": "Wifi Alert",
  "version": "1.0.0",
  "description": "Alerts you when connected to public Wi-Fi captive portals to help prevent evil twin and phishing attacks.",
  "permissions": [
    "webNavigation",
    "scripting",
    "storage"
  ],
  "host_permissions": [
	  "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
